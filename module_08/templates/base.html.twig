<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Blog</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: system-ui, sans-serif; background: #f5f5f3; color: #1a1a1a; }
        .page { max-width: 480px; margin: 3rem auto; padding: 0 1rem; }

        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .logo { font-size: 15px; font-weight: 500; }
        .logo span { color: #888; font-weight: 400; }
        .logout-btn { font-size: 12px; color: #ffffff; background: #ff3f3f; border: 0.5px solid #e0e0e0; border-radius: 99px; padding: 4px 12px; cursor: pointer; text-decoration: none; }
        .logout-btn:hover { background: #f5f5f3; color: #ff3f3f; border-color: #ff3f3f; }

        .card { background: #fff; border: 0.5px solid #e0e0e0; border-radius: 12px; padding: 2rem; }
        h2 { font-size: 18px; font-weight: 500; margin-bottom: 0.25rem; }
        .subtitle { font-size: 13px; color: #888; margin-bottom: 1.5rem; }
        label { display: block; font-size: 12px; color: #888; margin: 12px 0 4px; }
        input, textarea { width: 100%; padding: 8px 10px; border: 0.5px solid #e0e0e0; border-radius: 8px; font-size: 14px; outline: none; }
        input:focus, textarea:focus { border-color: #aaa; }
        textarea { resize: vertical; min-height: 100px; }
        .btn { width: 100%; margin-top: 1.25rem; padding: 10px; font-size: 14px; font-weight: 500; background: #1a1a1a; color: #fff; border: none; border-radius: 8px; cursor: pointer; }
        .btn:hover { background: #333; }
        .badge { display: inline-block; font-size: 11px; background: #469c00; color: #ffffff; padding: 2px 8px; border-radius: 99px; border: 0.5px solid #e0e0e0; margin-bottom: 1.5rem; }

        .toast { display: none; margin-bottom: 1rem; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; }
        .toast.success { background: #f0faf4; border: 0.5px solid #a3d9b1; color: #1a6b3a; }
        .toast.error { background: #fdf2f2; border: 0.5px solid #f0a8a8; color: #9b1c1c; }
        .toast.show { display: block; }

        .post-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 0.5px solid #e0e0e0; font-size: 14px; }
        .post-item:last-child { border-bottom: none; }
        .post-title { font-weight: 500; }
        .post-date { font-size: 12px; color: #888; }
        .post-empty { font-size: 13px; color: #888; padding: 10px 0; }
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.45); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; z-index: 9999; }

        .modal-content { position: relative; width: 90%; max-width: 700px; max-height: 80vh; overflow-y: auto; }

        .modal-close { position: absolute; top: 10px; right: 15px; background: transparent; border: none; font-size: 28px; cursor: pointer; }

        .post-title-link { cursor: pointer; }
        .post-item:hover .post-title-link { text-decoration: underline; text-underline-offset: 3px; }
        .post-item:hover { background: var(--color-background-secondary, #f5f5f3); border-radius: 8px; padding-left: 8px; padding-right: 8px; margin: 0 -8px; }
    </style>
</head>
<body>
    <div class="page">
        <div class="header">
            <div class="logo">Super<span> site</span></div>
            {% if app.user %}
                <a href="/logout" class="logout-btn">Se déconnecter</a>
            {% endif %}
        </div>

        <div id="toast" class="toast"></div>

        {% block content %}{% endblock %}
    </div>
    {% block scripts %}{% endblock %}
</body>
</html>