{% extends 'base.html.twig' %}
{% block content %}
    {% if app.user %}
        {{ form_start(form, {'attr': {'id': 'post-form', 'class': 'card'}}) }}
            <span class="badge">Connecté en tant que {{ app.user.username }}</span>
            <h2>Nouvel article</h2>
            <p class="subtitle">Rédigez et publiez votre post.</p>
            <label>Titre</label>
            {{ form_widget(form.title) }}
            <label>Contenu</label>
            {{ form_widget(form.content) }}
            <button type="submit" class="btn">Publier</button>
        {{ form_end(form) }}
    {% else %}
        {{ render(controller('App\\Controller\\UserController::loginAction')) }}
    {% endif %}

    {# Liste des posts - visible par tous #}
    <div class="posts-list" style="margin-top: 2rem;">
        <h2 style="font-size: 16px; font-weight: 500; margin-bottom: 1rem;">Articles publiés</h2>
        <ul id="posts-list" style="list-style: none;">
            {% for post in posts %}
                <li class="post-item">
                    <span class="post-title">{{ post.title }}</span>
                    <span class="post-date">{{ post.created|date('d/m/Y H:i') }}</span>
                </li>
            {% else %}
                <li class="post-empty">Aucun article publié pour le moment.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        function showToast(message, type) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast ' + type + ' show';
            setTimeout(() => { toast.className = 'toast'; }, 4000);
        }

        function addPostToList(post) {
            const list = document.getElementById('posts-list');

            // Supprime le message "aucun article" s'il existe
            const empty = list.querySelector('.post-empty');
            if (empty) empty.remove();

            const li = document.createElement('li');
            li.className = 'post-item';
            li.innerHTML = `<span class="post-title">${post.title}</span>
                            <span class="post-date">${post.created}</span>`;
            list.appendChild(li);
        }

        document.addEventListener('DOMContentLoaded', function () {

            // --- GESTION DU LOGIN ---
            const loginForm = document.getElementById('login-form');
            if (loginForm) {
                loginForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    fetch('/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            username: loginForm.email.value,
                            password: loginForm.password.value,
                        })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            showToast('Identifiants incorrects.', 'error');
                        }
                    });
                });
            }

            // --- GESTION DE LA SOUMISSION DU POST ---
            const postForm = document.getElementById('post-form');
            if (postForm) {
                postForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    fetch(postForm.action, {
                        method: 'POST',
                        body: new FormData(postForm),
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Article publié avec succès !', 'success');
                            postForm.reset();
                            addPostToList(data.post);
                        } else {
                            showToast('Erreur : ' + data.message, 'error');
                        }
                    });
                });
            }
        });
    </script>
{% endblock %}