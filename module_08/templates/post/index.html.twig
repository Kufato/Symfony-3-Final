{% extends 'base.html.twig' %}

{% block content %}

    {# =========================================================
       POST DETAIL MODAL
    ========================================================= #}
    <div id="post-modal" class="modal-overlay" style="display:none;">
        <div id="post-detail" class="modal-content card">
            <button id="close-modal" class="modal-close">&times;</button>
            <h2 id="detail-title"></h2>
            <span id="detail-date" class="post-date" style="font-size:12px; color:#888;"></span>
            <p id="detail-content" style="margin-top:1rem; font-size:14px; line-height:1.6;"></p>
            <button id="detail-delete-btn" class="btn"
                    style="margin-top:1rem; background:#ff3f3f; display:none;">
                Delete
            </button>
        </div>
    </div>

    {# =========================================================
       POST FORM — only rendered when the user is authenticated
    ========================================================= #}
    {{ form_start(form, {'attr': {'id': 'post-form', 'class': 'card'}}) }}
        <span class="badge">Logged in as {{ app.user.username }}</span>
        <h2>New article</h2>
        <p class="subtitle">Write and publish your post.</p>
        <label>Title</label>
        {{ form_widget(form.title) }}
        <label>Content</label>
        {{ form_widget(form.content) }}
        <button type="submit" class="btn">Publish</button>
    {{ form_end(form) }}

    {# =========================================================
       POSTS LIST — visible to all users
    ========================================================= #}
    <div class="posts-list" style="margin-top: 2rem;">
        <h2 style="font-size: 16px; font-weight: 500; margin-bottom: 1rem;">
            Published articles
        </h2>
        <ul id="posts-list" style="list-style: none;">
            {% for post in posts %}
                {# data-id is used by JS to identify the post for view/delete actions #}
                <li class="post-item" data-id="{{ post.id }}">
                    <span class="post-title post-title-link">{{ post.title }}</span>
                    <span style="display:flex; align-items:center; gap:6px;">
                        <span class="post-date">{{ post.created|date('d/m/Y H:i') }}</span>
                        <span class="post-arrow">›</span>
                    </span>
                </li>
            {% else %}
                <li class="post-empty">No articles published yet.</li>
            {% endfor %}
        </ul>
    </div>

{% endblock %}

{% block scripts %}
    <script>

        // =========================================================
        // TOAST
        // =========================================================
        function showToast(message, type) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast ' + type + ' show';
            setTimeout(() => { toast.className = 'toast'; }, 4000);
        }

        // =========================================================
        // ADD POST TO LIST
        // =========================================================
        function addPostToList(post) {
            const list = document.getElementById('posts-list');
            const empty = list.querySelector('.post-empty');
            if (empty) empty.remove();

            const li = document.createElement('li');
            li.className = 'post-item';
            li.dataset.id = post.id;
            li.innerHTML = `
                <span class="post-title post-title-link">${post.title}</span>
                <span style="display:flex; align-items:center; gap:6px;">
                    <span class="post-date">${post.created}</span>
                    <span class="post-arrow">›</span>
                </span>
            `;
            list.prepend(li);
            bindPostClick(li);
        }

        // =========================================================
        // OPEN MODAL
        // =========================================================
        function showPostDetail(post) {
            document.getElementById('detail-title').textContent   = post.title;
            document.getElementById('detail-date').textContent    = post.created;
            document.getElementById('detail-content').textContent = post.content;

            const deleteBtn = document.getElementById('detail-delete-btn');
            deleteBtn.style.display = post.canDelete ? 'block' : 'none';
            deleteBtn.dataset.id    = post.id;

            document.getElementById('post-modal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        // =========================================================
        // CLOSE MODAL
        // =========================================================
        function closeModal() {
            document.getElementById('post-modal').style.display = 'none';
            document.body.style.overflow = '';
        }

        // =========================================================
        // BIND CLICK ON POST TITLE
        // =========================================================
        function bindPostClick(li) {
            li.querySelector('.post-title-link')
                .addEventListener('click', function () {
                    fetch(`/view/${li.dataset.id}`)
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                showPostDetail(data.post);
                            } else {
                                showToast('Unable to load the post.', 'error');
                            }
                        });
                });
        }

        // =========================================================
        // WEBSOCKET
        // =========================================================
        const ws = new WebSocket('ws://localhost:8080');

        ws.onmessage = function (event) {
            const data = JSON.parse(event.data);

            if (data.type === 'post_created') {
                addPostToList(data.post);
            }

            if (data.type === 'post_deleted') {
                const li = document.querySelector(
                    `#posts-list .post-item[data-id="${data.id}"]`
                );
                if (li) li.remove();

                const deleteBtn = document.getElementById('detail-delete-btn');
                if (deleteBtn && deleteBtn.dataset.id == data.id) {
                    closeModal();
                }
            }
        };

        document.addEventListener('DOMContentLoaded', function () {

            // Bind click on server-rendered posts
            document.querySelectorAll('#posts-list .post-item').forEach(bindPostClick);

            // Close modal — × button
            document.getElementById('close-modal').addEventListener('click', closeModal);

            // Close modal — click outside
            document.getElementById('post-modal').addEventListener('click', function (e) {
                if (e.target === this) closeModal();
            });

            // Close modal — Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeModal();
            });

            // =========================================================
            // DELETE POST
            // =========================================================
            document.getElementById('detail-delete-btn')
                .addEventListener('click', function () {
                    const id = this.dataset.id;
                    if (!confirm('Delete this article?')) return;

                    fetch(`/delete/${id}`, {
                        method: 'DELETE',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            ws.send(JSON.stringify({ type: 'post_deleted', id: data.id }));
                            showToast('Article deleted.', 'success');
                        } else {
                            showToast('Error while deleting the article.', 'error');
                        }
                    });
                });

            // =========================================================
            // CREATE POST
            // =========================================================
            const postForm = document.getElementById('post-form');
            if (postForm) {
                postForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    fetch(postForm.action, {
                        method: 'POST',
                        body: new FormData(postForm),
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Article published successfully!', 'success');
                            postForm.reset();
                            ws.send(JSON.stringify({ type: 'post_created', post: data.post }));
                        } else {
                            showToast('Error: ' + data.message, 'error');
                        }
                    });
                });
            }
        });

    </script>
{% endblock %}